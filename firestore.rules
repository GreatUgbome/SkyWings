rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Central rule helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Match the artifacts structure (appId defaults to skywings-v2)
    match /artifacts/{appId} {
      
      // USER DATA: Only the authenticated user can read/write their own data
      match /users/{userId} {
        allow read, write: if isOwner(userId);
        
        // Allow access to user's subcollections (bookings, wishlist, etc)
        match /{subcollection}/{document=**} {
          allow read, write: if isOwner(userId);
        }
      }

      // PUBLIC DATA NESTED STRUCTURE: /public/data/{collection}/{document} and deeper
      match /public/data/{allPaths=**} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin() || isAuthenticated();
      }

      // PUBLIC BOOKINGS COLLECTION (at root level)
      match /public/bookings/{bookingId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin() || isAuthenticated();
      }

      // FLIGHTS AT PUBLIC ROOT
      match /public/flights/{flightId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      // BOOKINGS COLLECTION (Standalone)
      match /bookings/{bookingId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin() || isAuthenticated();
      }

      // PUBLIC FLIGHTS: Authenticated users can read, only admins can write
      match /flights/{flightId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      // AIRLINES: Authenticated users can read, admins can write
      match /airlines/{airlineId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      // AIRPORTS: Authenticated users can read, admins can write
      match /airports/{airportId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      // PUBLIC ALERTS: Authenticated users can read, admins write
      match /alerts/{alertId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }

      // TRACKING DATA: Authenticated users can read (broadcast alert doc + specific refs)
      match /tracking/{document=**} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // SYSTEM DATA: Admins only
      match /system/{document=**} {
        allow read, write: if isAdmin();
      }
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}